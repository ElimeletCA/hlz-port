# ── Datos de origen y salida (nunca en git) ───────────────────────────────────
input/
out/
reverse/decompiled/

# ── Arte fuente privado ────────────────────────────────────────────────────────
art/raw/
art/work/
art/concepts/

# ── Godot ─────────────────────────────────────────────────────────────────────
# Ignorar la caché interna del editor (generada automáticamente)
godot/.godot/uid_cache.bin
godot/.godot/global_script_class_cache.cfg
godot/.godot/editor/
godot/.godot/mono/
# Excepción: importados de art_samples (necesarios para correr sin el editor)
!godot/.godot/imported/
godot/export_presets.cfg
*.import
# Excepción: .import de art_samples (generados por tools/generar_import_godot.py)
!godot/art_samples/*.import

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
venv/

# ── Editor y OS ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
Thumbs.db
Desktop.ini
.DS_Store

# ── Logs temporales ───────────────────────────────────────────────────────────
*.log

# ── Emulador J2ME (datos locales de ejecucion y guardado) ─────────────────────
config/
freej2me_system/
rms/

